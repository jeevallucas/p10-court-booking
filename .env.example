# PostgreSQL connection for the API, migrations, and tests. docker compose provides this one.
DATABASE_URL=postgres://court:court@localhost:5432/court_booking?sslmode=disable

# Shared secret that signs and checks payment notifications. Any long random string works
# locally; the demo host keeps its own in its secret settings.
PAYMENT_SERVER_KEY=change-me-to-a-long-random-string

# Where the browser reaches the web app; payment links and the return page are built from it.
PUBLIC_WEB_URL=http://localhost:3000

# Send outbox messages to Mailpit from docker compose. Leave empty to write them to the log.
SMTP_ADDR=localhost:1025

# Session cookies need HTTPS unless this is false; plain http://localhost works either way in
# current browsers.
COOKIE_SECURE=true
