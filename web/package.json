{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "generate:api": "openapi-typescript ../openapi.yaml -o src/api/schema.d.ts",
    "format": "prettier --write .",
